# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-5.6-luna

# Windows MetaTrader 5 terminal path
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

SYMBOL=XAUUSD
TIMEFRAME=M5
POLL_SECONDS=5
CANDLES_TO_LOAD=120
CANDLES_TO_AI=30

# V3 deterministic pre-filter.
# OpenAI is called only when the latest CLOSED candle passes these rules.
FILTER_ENABLED=true
FILTER_LOOKBACK=12
FILTER_MIN_SCORE=4
FILTER_MIN_ATR_RATIO=0.00035
FILTER_MAX_SPREAD_ATR_RATIO=0.12
FILTER_BREAKOUT_BUFFER_ATR=0.25
FILTER_MIN_EMA_GAP_ATR=0.10
FILTER_RSI_BULL=52
FILTER_RSI_BEAR=48
